model School {
    id               String   @id @default(cuid())
    name             String
    abbreviation     String   @unique
    emailFormats     String[]
    studentIdFormat  Json?
    users            User[]
    admins           Admin[]
    shops            Shop[]
    instagramAccount String?
    websiteUrl       String?
    isLimited        Boolean  @default(false)
    iconUrl          String   @default("https://static.wikia.nocookie.net/adventures-of-chris-and-tifa/images/c/c1/ThisIsFineDog.jpeg/revision/latest?cb=20241003041905")

    drafts ShopDraft[]

    adminInvites  AdminInvite[]
    archivedShops ArchivedShop[]

    partnershipPeriod PartnershipPeriod[]

    @@index([abbreviation])
}
